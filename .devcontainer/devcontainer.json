{
  "name": "Copilot Studio MCP Demo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22",
      "npmVersion": "10.9.0"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "terragrunt": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-azurefunctions",
        "ms-python.python",
        "ms-python.vscode-python-envs"
      ]
    }
  },
  "forwardPorts": [7071],
  "postCreateCommand": "dotnet tool install --global Microsoft.PowerApps.CLI.Tool --version 2.12.2 && npm install --global azure-functions-core-tools@4 --unsafe-perm true @polycloudinc/opmc && uv sync --project msft-mcmc-mcp/msft-mcmc-mcp-service"
}
